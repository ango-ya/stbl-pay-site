{
  "name": "stbl-pay-site",
  "version": "1.0.0",
  "description": "すてぶるペイ（STBL Pay）公開サイト（LP・デモ）。stbl-pay.com として Cloudflare Pages で配信。",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "check": "./scripts/check-acceptance.sh && ./scripts/check-lr006-terms.sh",
    "test:figures": "node --test scripts/figures/outputs.test.mjs",
    "openapi:build": "node scripts/build-openapi.mjs",
    "openapi:check": "node scripts/build-openapi.mjs --check && node scripts/openapi-en.mjs --check",
    "test:machine-openapi": "node --test scripts/machine-openapi.test.mjs",
    "test:refund-signer": "node --test scripts/refund-signer.test.mjs",
    "build:docs": "bash scripts/build-dist.sh",
    "lint:openapi": "npm --prefix docs-site run lint:openapi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ango-ya/stbl-pay-site.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
